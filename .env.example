# =============================================================================
# Heliora Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local or any file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# Base URL for the Heliora REST API.
# Required. Provided by the backend team.
# Example (local dev): http://localhost:3000/api/v1
# Example (staging):   https://api-staging.heliora.io/v1
# Example (prod):      https://api.heliora.io/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# -----------------------------------------------------------------------------
# Stellar Network
# -----------------------------------------------------------------------------

# Stellar network to connect to.
# Optional. Defaults to "testnet" if not set.
# Accepted values: "testnet" | "mainnet"
# WARNING: Setting this to "mainnet" means transactions use real XLM.
#          Ensure all other Stellar variables are also updated for mainnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon API endpoint used to submit transactions and query the ledger.
# Optional. Defaults to the Stellar Foundation testnet URL if not set.
# Testnet:  https://horizon-testnet.stellar.org  (provided by Stellar Foundation)
# Mainnet:  https://horizon.stellar.org           (provided by Stellar Foundation)
# Self-hosted: https://horizon.your-domain.com
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint used to simulate and submit contract invocations.
# Optional on testnet (defaults to https://soroban-testnet.stellar.org).
# Required on mainnet: SDF does not host a public mainnet RPC, so use an RPC provider.
NEXT_PUBLIC_SOROBAN_RPC_URL=

# -----------------------------------------------------------------------------
# SEP-38 Anchor Quotes (cross-border appointment payments)
# -----------------------------------------------------------------------------

# Home domain of the anchor whose stellar.toml publishes ANCHOR_QUOTE_SERVER,
# WEB_AUTH_ENDPOINT and SIGNING_KEY (e.g. testanchor.stellar.org).
# Optional. The "Other currency" payment option is disabled when unset.
NEXT_PUBLIC_SEP38_ANCHOR_DOMAIN=

# -----------------------------------------------------------------------------
# Missed-Consultation Disputes
# -----------------------------------------------------------------------------

# Soroban arbitration contract ID (C...) that verifies oracle attestations and
# refunds patients when the doctor does not join within 15 minutes.
NEXT_PUBLIC_ARBITRATION_CONTRACT_ID=

# Ed25519 public key (G...) of the Heliora dispute oracle that signs attestations.
NEXT_PUBLIC_DISPUTE_ORACLE_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Telemedicine Video (Daily.co)
# -----------------------------------------------------------------------------

# Daily.co subdomain used to generate video call rooms for telemedicine
# appointments (https://<domain>.daily.co/<room>).
# Optional. Defaults to "heliora" if not set.
NEXT_PUBLIC_DAILY_DOMAIN=heliora

# WebSocket endpoint for appointment chat. The client appends
# /appointments/<id>/chat. If omitted, NEXT_PUBLIC_API_URL or the current host
# is used with ws:// or wss:// as appropriate.
NEXT_PUBLIC_CHAT_WS_URL=

# -----------------------------------------------------------------------------
# Sentry Error Monitoring
# -----------------------------------------------------------------------------

# Sentry DSN for error reporting. Required for production error tracking.
# Get this from your Sentry project settings: Settings > Projects > [project] > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for source map uploads during build.
# Generate at: Settings > Auth Tokens
SENTRY_AUTH_TOKEN=

# Sentry organization slug
SENTRY_ORG=

# Sentry project slug
SENTRY_PROJECT=

# SEP-10 backend auth: the server's challenge signing key (G...) and its home domain.
# The same key signs anti-phishing shield attestations (SEP-53). When unset, the
# login shield is still shown but cannot be cross-checked with the server.
NEXT_PUBLIC_AUTH_SIGNING_KEY=
NEXT_PUBLIC_AUTH_HOME_DOMAIN=

# -----------------------------------------------------------------------------
# Anti-phishing domain check
# -----------------------------------------------------------------------------

# Comma-separated hostnames the genuine Heliora frontend is served from, e.g.
# app.heliora.io,heliora.io. The login page warns when it is opened on any other
# hostname or without HTTPS. localhost is always treated as development.
# Recommended in production; when unset the banner reports the deployment as unconfigured.
NEXT_PUBLIC_OFFICIAL_DOMAINS=
