{
  "name": "@heliora/circuits",
  "version": "0.1.0",
  "private": true,
  "description": "Circom circuits for Heliora's zero-knowledge eligibility proofs, with a constraint/proving-time benchmark harness.",
  "scripts": {
    "benchmark": "ts-node --project tsconfig.json benchmark.ts",
    "benchmark:constraints": "ts-node --project tsconfig.json benchmark.ts --no-prove",
    "benchmark:update-baseline": "ts-node --project tsconfig.json benchmark.ts --no-prove --update-baseline"
  },
  "devDependencies": {
    "@types/node": "^20",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
